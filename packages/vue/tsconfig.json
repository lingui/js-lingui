{
  "compilerOptions": {
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "target": "es2023",
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vitest/globals"]
  },
  "exclude": ["dist", "node_modules", "**/__typetests__/**", "test/fixtures/**"]
}
